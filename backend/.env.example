# Backend deployment template, for running the backend without compose.yaml (which sets these itself).
# Copy to .env, fill in, and pass it to the runtime, e.g. `docker run --env-file .env`. Spring Boot does not read
# .env files on its own. Empty values are required: without them the backend fails at startup.

# Empty in production; dev enables Swagger, all actuator endpoints and debug logging
SPRING_PROFILES_ACTIVE=

# Browser origins allowed for CORS and WebSocket, comma-separated (e.g. https://chess.example.com)
APP_ALLOWED_ORIGINS=

# e.g. jdbc:postgresql://<host>:5432/chessdb
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=

# RabbitMQ over AMQP, for AI game analysis jobs. The backend starts without the analysis service; requests then fail
# with "temporarily unavailable". Use the same credentials as the STOMP relay below.
SPRING_RABBITMQ_HOST=
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=
SPRING_RABBITMQ_PASSWORD=

# RabbitMQ STOMP relay, required when running more than one instance. With a single instance, set
# APP_WEBSOCKET_RELAY_ENABLED=false and leave the rest empty to use the in-memory broker.
APP_WEBSOCKET_RELAY_ENABLED=true
APP_WEBSOCKET_RELAY_HOST=
APP_WEBSOCKET_RELAY_PORT=
APP_WEBSOCKET_RELAY_LOGIN=
APP_WEBSOCKET_RELAY_PASSCODE=

# Optional, defaults shown
# SERVER_ADDRESS=0.0.0.0
# SERVER_PORT=8080
