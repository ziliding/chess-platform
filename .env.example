# Docker Compose template: copy to .env and fill in. compose.yaml reads these and passes them to the db,
# rabbitmq and backend containers. Values shown are the local dev defaults; change every password before deploying.
# To deploy the backend on its own, see backend/.env.example.

# dev for local development (Swagger, all actuator endpoints, debug logging). Leave empty when deploying:
SPRING_PROFILES_ACTIVE=dev

# Browser origins allowed for CORS and WebSocket, comma-separated (e.g. https://chess.example.com)
APP_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

DB_USER=root
DB_PASSWORD=password
DB_NAME=chessdb

RABBITMQ_USER=chess
RABBITMQ_PASSWORD=password

# Depth of the Stockfish search for AI game analysis; deeper is slower. 16 takes roughly 10-20 s for a 40-move game.
# Raising it also means raising app.analysis.deadline in the backend.
ANALYSIS_ENGINE_DEPTH=16

# Optional: an OpenAI-compatible LLM that explains the analysis. Leave LLM_BASE_URL or LLM_MODEL empty to keep the
# engine's summary. For Ollama on this machine: LLM_BASE_URL=http://host.docker.internal:11434/v1 and no key.
# For OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 and its API key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
